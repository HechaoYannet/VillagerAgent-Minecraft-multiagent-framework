# ═══════════════════════════════════════════════════════════
# Git 换行符规则
# ═══════════════════════════════════════════════════════════
# - Linux 脚本/Docker 文件必须是 LF，否则容器内执行失败
# - PowerShell 脚本可用 CRLF (Windows 原生)
# - Python/TOML/YAML 统一用 LF (跨平台兼容)

# Shell 脚本 → 强制 LF (Linux / Docker 执行)
*.sh       text eol=lf

# Docker 相关 → 强制 LF
Dockerfile           text eol=lf
.dockerignore        text eol=lf
docker-compose*.yml  text eol=lf

# Python / 配置 → LF (跨平台一致)
*.py        text eol=lf
*.toml      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.txt       text eol=lf
*.md        text eol=lf

# PowerShell 脚本 → CRLF (Windows 原生)
*.ps1       text eol=crlf

# Node.js → LF
package.json   text eol=lf
*.js           text eol=lf
*.json         text eol=lf

# 二进制文件
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pth    binary
*.bin    binary
*.zip    binary
*.gz     binary
